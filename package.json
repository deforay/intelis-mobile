{
  "name": "vlsm-app",
  "version": "1.6.0",
  "author": "Deforay",
  "homepage": "https://vlsm.app/",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "bundlezipalign": "zipalign -f -v 4 platforms/android/app/build/outputs/bundle/release/app-release.aab VLSM.aab",
    "bundlejarsign": "jarsigner -verbose -keystore my-release-key.keystore platforms/android/app/build/outputs/bundle/release/app-release.aab vlsm",
    "appzipalign": "zipalign -f -v 4 platforms/android/app/build/outputs/apk/release/app-release-unsigned.apk VLSM.apk",
    "appjarsign": "jarsigner -verbose -keystore my-release-key.keystore platforms/android/app/build/outputs/apk/release/app-release-unsigned.apk vlsm",
    "keygen": "  keytool -genkey -v -keystore my-release-key.keystore -alias vlsm -keyalg RSA -keysize 2048 -validity 10000",
    "release": "ionic cordova build android --configuration production --release",
    "dbuild": "ionic cordova build android",
    "s": "ionic serve --cordova --platform browser",
    "t": "ionic cordova run android",
    "r": "native-run android --app platforms/android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "private": true,
  "dependencies": {
